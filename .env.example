# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=access-logs
KAFKA_GROUP_ID=sqli-consumer

# OpenSearch
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX=sqli-detections

# SQLi model artefacts
MODELS_DIR=/app/models

# Index policy: all | scored | no_qs | alerts_only
INDEX_MODE=scored

# Logging
LOG_LEVEL=INFO

# SQLi thresholds are stored in models/sqli_detector_config.json
# NB27 defaults: T_LOW=0.65, T_HIGH=0.81
